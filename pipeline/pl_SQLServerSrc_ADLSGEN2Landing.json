{
	"name": "pl_SQLServerSrc_ADLSGEN2Landing",
	"properties": {
		"activities": [
			{
				"name": "Lookupsqlservercontroltable",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sqlserverTablesparameter",
						"type": "DatasetReference",
						"parameters": {
							"pDsServerName": "localhost\\SQLEXPRESS",
							"pDsdatabaseName": "dev_clintrail_edc_src",
							"pDsSchemaName": "edcsrcmetadata",
							"pDsTableName": "srcEdcClintrailToLandControl"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookupsqlservercontroltable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookupsqlservercontroltable').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "copydata_sqlserver_landing",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "@if(equals(item().IngestionType,'Incremental'),\n    concat('SELECT * FROM ',item().SrcSchemaName,'.',item().SrcTableName,\n            ' WHERE ' ,coalesce(item().WatermarkColName,''),\n            ' > ''',coalesce(string(item().WatermarkColValue),''),''''),\n    concat('SELECT * FROM ',item().SrcSchemaName,\n         '.',item().SrcTableName))",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_sqlserverTablesparameter",
									"type": "DatasetReference",
									"parameters": {
										"pDsServerName": {
											"value": "@item().SrcServerName",
											"type": "Expression"
										},
										"pDsdatabaseName": {
											"value": "@item().SrcDatabaseName",
											"type": "Expression"
										},
										"pDsSchemaName": {
											"value": "@item().SrcSchemaName",
											"type": "Expression"
										},
										"pDsTableName": {
											"value": "@item().SrcTableName",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_clinical_param1",
									"type": "DatasetReference",
									"parameters": {
										"pDsContainerName": {
											"value": "@item().LandingContainerName",
											"type": "Expression"
										},
										"pDsFolderName": {
											"value": "@concat(item().SrcSchemaName,'/',item().SrcTableName,'/ingest_date-',formatDateTime(utcNow(),'yyyy-MM-dd'))",
											"type": "Expression"
										},
										"pDsFileName": {
											"value": "@concat(item().SrcTableName, '_',formatDateTime(utcNow(),'yyyyMMddHHmmss'), '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Lookup_get max metadat value",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "copydata_sqlserver_landing",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT ,MAX([', coalesce(item().WatermarkColName,'MODIFIED_TS'),']) AS NewWatermark FROM ', item().SrcSchemaName, '.', item().SrcTableName)",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "ds_sqlserverTablesparameter",
									"type": "DatasetReference",
									"parameters": {
										"pDsServerName": {
											"value": "@item().SrcServerName",
											"type": "Expression"
										},
										"pDsdatabaseName": {
											"value": "@item().SrcDatabaseName",
											"type": "Expression"
										},
										"pDsSchemaName": {
											"value": "@item().SrcSchemaName",
											"type": "Expression"
										},
										"pDsTableName": {
											"value": "@item().SrcTableName",
											"type": "Expression"
										}
									}
								}
							}
						},
						{
							"name": "Stored procedure  update max modifieddt",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Lookup_get max metadat value",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[edcsrcmetadata].[usp_UpdateMxWatermark]",
								"storedProcedureParameters": {
									"Metadataid": {
										"value": {
											"value": "@item().MetadataId",
											"type": "Expression"
										}
									},
									"NewWaterMarkValue": {
										"value": {
											"value": "@activity('Lookup_get max metadat value').output.firstRow.NewWatermark",
											"type": "Expression"
										}
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_sqlserver_param",
								"type": "LinkedServiceReference",
								"parameters": {
									"pLsServerName": {
										"value": "@item().SrcServerName",
										"type": "Expression"
									},
									"pLsDatabaseName": {
										"value": "@item().SrcDatabaseName",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"folder": {
			"name": "dev_clintrial/SQLServerSrc_ADLSDEN2Landing"
		},
		"annotations": []
	}
}